{
  "zeeli-controller": {
    "description": "Zeeli Controller: service state and the few app commands the console runs, and its own updates",
    "read": {
      "ubus": {
        "rc": ["list"]
      }
    },
    "write": {
      "ubus": {
        "rc": ["init"]
      },
      "file": {
        "/usr/bin/iperf3 -s -1 -D": ["exec"],
        "/usr/bin/etherwake -i br-lan *": ["exec"],
        "/usr/libexec/zeeli-update install *": ["exec"]
      }
    }
  }
}
