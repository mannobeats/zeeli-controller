#!/bin/sh
# Installs Zeeli Controller on this router, or updates it, from a GitHub release.
# Every download must carry a signature from the project's release key before anything
# is replaced. The console runs `install <tag>` through its permission file.
#
#   zeeli-update install latest      the newest release
#   zeeli-update install v1.2.3      a given release
#   zeeli-update apply <file>        an unsigned package from `pnpm deploy:router`, over SSH only
#   zeeli-update remove              take the console, the agent and this updater off the router
#
# First install, from an SSH session on the router:
#   uclient-fetch -qO /tmp/zeeli-update https://github.com/mannobeats/zeeli-controller/releases/latest/download/zeeli-update && sh /tmp/zeeli-update install latest
set -eu

REPO=mannobeats/zeeli-controller
DEST=/www/zeeli
ACL=/usr/share/rpcd/acl.d/zeeli-controller.json
SELF=/usr/libexec/zeeli-update
# the public half of the release key; a new key ships in a release signed by the old one
KEY='untrusted comment: Zeeli Controller release key
RWQINVCQZITZyqGOockgT4DEmL61ghbXN1KBCaGEGhBzwQm3zGjg1fQ/'

fail() {
  echo "$*" >&2
  exit 1
}

# one install at a time; a lock left by a run that was killed goes after ten minutes
LOCK=/tmp/zeeli-update.lock
find /tmp -maxdepth 1 -name zeeli-update.lock -mmin +10 -exec rm -rf {} \; 2>/dev/null
mkdir "$LOCK" 2>/dev/null || fail "Another Zeeli install is already running. Try again in a minute."
TMP=$(mktemp -d /tmp/zeeli-update.XXXXXX)
trap 'rm -rf "$TMP" "$LOCK"' EXIT

download() {
  uclient-fetch -q -T 30 -O "$TMP/$1" "$URL/$1" 2>/dev/null || fail "Couldn’t download $1 from GitHub. Check the router’s internet connection."
}

# Unpack a package and put it in place: the console folder in one move, then the updater
# and the permission file, reloading permissions only when they changed.
apply() {
  mkdir "$TMP/pkg"
  tar -C "$TMP/pkg" -xzf "$1" || fail "The package is damaged."
  # files run as root, so root owns them, whoever packed the archive
  chown -R 0:0 "$TMP/pkg"
  [ -f "$TMP/pkg/www/index.html" ] && [ -f "$TMP/pkg/VERSION" ] || fail "The package is missing files."

  rm -rf "$DEST.new" "$DEST.old"
  cp -a "$TMP/pkg/www" "$DEST.new"
  { [ ! -d "$DEST" ] || mv "$DEST" "$DEST.old"; } && mv "$DEST.new" "$DEST" && rm -rf "$DEST.old"

  # copy, then rename, so this script is never rewritten while it runs
  mkdir -p "${SELF%/*}"
  cp "$TMP/pkg/zeeli-update" "$SELF.new" && chmod 755 "$SELF.new" && mv "$SELF.new" "$SELF"
  if ! cmp -s "$TMP/pkg/zeeli-controller.acl.json" "$ACL"; then
    cp "$TMP/pkg/zeeli-controller.acl.json" "$ACL.new" && mv "$ACL.new" "$ACL"
    /etc/init.d/rpcd reload
  fi
  [ ! -d "$TMP/pkg/root" ] || agent "$TMP/pkg/root"
  echo "Installed Zeeli Controller $(cat "$TMP/pkg/VERSION")"
}

# The agent: files laid out as they sit on the router. Copy what changed, remove what a
# release dropped (from the last install's manifest), then restart what reads them.
agent() {
  MANIFEST=/usr/share/zeeli/manifest
  NEW=$(cd "$1" && find . -type f | sed 's#^\.##' | sort)
  CHANGED=
  SERVICES=
  for f in $(cat "$MANIFEST" 2>/dev/null); do
    echo "$NEW" | grep -qx "$f" && continue
    case "$f" in /etc/init.d/*) [ ! -x "$f" ] || { "$f" stop; "$f" disable; } || true ;; esac
    rm -f "$f"
    CHANGED=1
  done
  for f in $NEW; do
    cmp -s "$1$f" "$f" && continue
    mkdir -p "${f%/*}" && cp -p "$1$f" "$f.new" && mv "$f.new" "$f"
    CHANGED=1
  done
  echo "$NEW" >"$MANIFEST"
  # root owns everything that runs as root, including files an older install left alone
  for f in $NEW; do chown 0:0 "$f"; done
  # services start once every file they read is in place
  if [ -n "$CHANGED" ]; then
    for f in $NEW; do
      case "$f" in /etc/init.d/*) "$f" enable; "$f" restart || echo "${f##*/} didn’t start" >&2 ;; esac
    done
  fi
  # rpcd loads the agent's objects and nginx the bridge only when they start. Do it after
  # this script has answered, since the console may be calling it through rpcd right now.
  [ -z "$CHANGED" ] || (sleep 2; /etc/init.d/rpcd restart; /etc/init.d/nginx reload) </dev/null >/dev/null 2>&1 &
}

case "${1:-}" in
  install)
    TAG="${2:-}"
    if [ "$TAG" = latest ]; then
      URL="https://github.com/$REPO/releases/latest/download"
    elif echo "$TAG" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
      URL="https://github.com/$REPO/releases/download/$TAG"
    else
      fail "Not a release: $TAG"
    fi
    download zeeli-controller.tar.gz
    download zeeli-controller.tar.gz.sig
    printf '%s\n' "$KEY" >"$TMP/key.pub"
    usign -V -q -m "$TMP/zeeli-controller.tar.gz" -p "$TMP/key.pub" || fail "The download isn’t signed with the Zeeli Controller release key, so nothing was installed."
    apply "$TMP/zeeli-controller.tar.gz"
    ;;
  apply)
    [ -f "${2:-}" ] || fail "No package at ${2:-}"
    apply "$2"
    ;;
  remove)
    # services first, so nothing writes while the rest goes; the manifest goes last
    for f in $(cat /usr/share/zeeli/manifest 2>/dev/null); do
      case "$f" in /etc/init.d/*) [ ! -x "$f" ] || { "$f" stop; "$f" disable; } || true ;; esac
    done
    for f in $(cat /usr/share/zeeli/manifest 2>/dev/null); do rm -f "$f"; done
    # WiFi networks a schedule was holding off come back on, since nothing will turn them on later
    for s in $(uci -q show wireless | sed -n "s/^wireless\.\(zeeli_[a-z0-9_]*\)\.sched_off='1'$/\1/p"); do
      uci -q set "wireless.$s.disabled=0" || true
      uci -q delete "wireless.$s.sched_off" || true
      HELD=1
    done
    [ -z "${HELD:-}" ] || { uci commit wireless; wifi reload || true; }
    # what the agent wrote into the router's own settings: the policies' firewall include and
    # the dnsmasq sets that fill it. Zeeli's WiFi networks stay; they're plain WiFi networks.
    uci -q delete firewall.zeeli_policies || true
    for s in $(uci -q show dhcp | sed -n "s/^dhcp\.\(zeeli_[a-z0-9_]*\)=ipset$/\1/p"); do uci -q delete "dhcp.$s" || true; done
    uci commit firewall
    uci commit dhcp
    # speed limits the policies set (zeeli_applied lists them as mac=down=up); the last del
    # also stops gl_eqos's queue
    for e in $(uci -q get zeeli.zeeli_applied.limit); do
      /usr/bin/gl_eqos del "$(echo "${e%%=*}" | tr 'a-f' 'A-F')" || true
    done
    uci -q delete zeeli.zeeli_applied || true
    uci -q commit zeeli || true
    rm -rf "$DEST" /usr/share/zeeli /usr/share/ucode/zeeli /usr/libexec/zeeli /etc/zeeli "$ACL" "$SELF" \
      /usr/share/gl-upload.d/zeeli /usr/share/gl-download.d/zeeli /tmp/zeeli /var/lib/zeeli
    /etc/init.d/firewall reload || true
    # fw4 keeps chains and sets it no longer declares, so the policies' own go by hand
    nft delete chain inet fw4 zeeli_forward 2>/dev/null || true
    for c in $(nft list table inet fw4 2>/dev/null | sed -n 's/^[[:space:]]*chain \(zeeli_[a-z0-9_]*\) {.*/\1/p'); do nft delete chain inet fw4 "$c" 2>/dev/null || true; done
    for t in $(nft list table inet fw4 2>/dev/null | sed -n 's/^[[:space:]]*set \(zeeli_[a-z0-9_]*\) {.*/\1/p'); do nft delete set inet fw4 "$t" 2>/dev/null || true; done
    /etc/init.d/dnsmasq reload || true
    /etc/init.d/rpcd restart || true
    /etc/init.d/nginx reload || true
    echo "Removed Zeeli Controller. Kept: its settings (/etc/config/zeeli), history and snapshots (/overlay/zeeli) and the WiFi networks it made. Delete those too for a clean router."
    ;;
  *)
    fail "Usage: zeeli-update install <latest|v1.2.3> | remove"
    ;;
esac
