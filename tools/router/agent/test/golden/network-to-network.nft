table inet zeeli_check {
	define guest_devices = { "br-guest" }
	define iot_devices = { "br-iot" }
	define lan_devices = { "br-lan" }
	define wan_devices = { "eth0", "sta1" }

# Written by the Zeeli agent from your policies. Changes made here are overwritten.

	set zeeli_c_000006 {
		type ether_addr
		elements = {
			02:5e:e1:24:33:d0,
		}
	}

	chain zeeli_p_000003 {
		iifname $guest_devices oifname $lan_devices counter drop
	}

	chain zeeli_p_000006 {
		ether saddr @zeeli_c_000006 oifname $iot_devices counter drop
	}

	chain zeeli_forward {
		type filter hook forward priority -1; policy accept;
		jump zeeli_p_000003
		jump zeeli_p_000006
	}
}
