table inet zeeli_check {
# Written by the Zeeli agent from your policies. Changes made here are overwritten.

	set zeeli_c_000006 {
		type ether_addr
		elements = {
			02:5e:e1:24:33:d0,
		}
	}

	chain zeeli_p_000003 {
		iifname { "br-guest" } oifname { "br-lan" } counter drop
