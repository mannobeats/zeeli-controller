table inet zeeli_check {
# Written by the Zeeli agent from your policies. Changes made here are overwritten.

	set zeeli_c_000007 {
		type ether_addr
		elements = {
			02:5e:e1:31:90:f4,
		}
	}

	chain zeeli_p_000007 {
		ether saddr @zeeli_c_000007 fib daddr type != { local, broadcast, multicast } meta mark and 0x0f000000 == 0x00000000 counter meta mark set meta mark or 0x01001000
	}

	chain zeeli_k_000007 {
		meta mark and 0x0f000000 == 0x01000000 oifname { "eth0", "eth2", "sta1" } counter drop
	}

	chain zeeli_route {
		type filter hook prerouting priority -151; policy accept;
		jump zeeli_p_000007
	}

	chain zeeli_forward {
		type filter hook forward priority -1; policy accept;
		jump zeeli_k_000007
	}

	chain zeeli_rev {
		counter comment "zeeli-rev:117510cc"
	}
}
