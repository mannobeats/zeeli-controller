#!/bin/sh /etc/rc.common
# Records the router's history every minute. It runs at low priority and sleeps between samples.
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/zeeli/zeeli-collector run
	# restart whenever it dies, without limit
	procd_set_param respawn 3600 5 0
	procd_set_param nice 10
	procd_set_param stderr 1
	procd_close_instance
}

# runs before the process is stopped: keep what's in RAM
stop_service() {
	/usr/bin/ucode /usr/libexec/zeeli/zeeli-collector persist
}
