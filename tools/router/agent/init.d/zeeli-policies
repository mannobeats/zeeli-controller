#!/bin/sh /etc/rc.common
# Keeps Zeeli's policies true as time passes: schedules start and end, pauses run out, and
# sites stay current, all with the console closed.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/zeeli/policy-loop
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
